# Heretek Swarm Environment Configuration Example
# Copy this file to .env and fill in your actual values
#
# Docker Compose profiles:
#   docker compose up                      # Core services
#   docker compose --profile autonomous up -d  # + autonomous runtime
#   docker compose --profile mem0 up             # + Mem0 self-hosted memory
#   docker compose --profile litellm up          # + LiteLLM proxy
#   docker compose --profile all up -d         # All services

# =============================================================================
# API Configuration
# =============================================================================
HERETEK_API_KEY=htsk_your_api_key_here

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# CORS Configuration (Production)
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/heretek_swarm
POSTGRES_PASSWORD=password

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# Qdrant Configuration (Vector Database)
# =============================================================================
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# =============================================================================
# OpenAI Compatible LLM Configuration
# =============================================================================
# Supports any OpenAI-compatible API (MiniMax, Together, Fireworks, etc.)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M2.7

# =============================================================================
# Embedding Provider (Lemonade Server / OpenAI Compatible)
# =============================================================================
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://127.0.0.1:13305/api/v1
EMBEDDING_API_KEY=lemonade
EMBEDDER_MODEL=nomic-embed-text-v2-moe-GGUF
EMBEDDING_DIMENSIONS=768

# =============================================================================
# Logging Configuration
# =============================================================================
HERETEK_LOG_LEVEL=INFO

# =============================================================================
# Agent Configuration
# =============================================================================
MAX_MAILBOX_SIZE=1000
HEARTBEAT_INTERVAL=10.0
PHASE_TIMEOUT=60.0

# =============================================================================
# Consensus Configuration
# =============================================================================
CONSENSUS_AHEAD_BY_K=2
CONSENSUS_MIN_VOTES=3
CONSENSUS_CONFIDENCE_THRESHOLD=0.6

# =============================================================================
# Memory Configuration
# =============================================================================
MEMORY_MAX_SIZE=10000
MEMORY_DEFAULT_TTL=3600

# =============================================================================
# Mem0 Self-Hosted Configuration (--profile mem0)
# =============================================================================
# PostgreSQL password for Mem0 metadata storage
POSTGRES_PASSWORD=mem0-secret-change-me

# Mem0 LLM provider: "ollama" for local, or "openai" for external API
MEM0_LLM_PROVIDER=ollama
MEM0_LLM_MODEL=llama3.2:latest

# Use LlamaParser for document parsing (optional, requires service running)
# MEM0_USE_LLAMAPARSER=true
# LLAMAPARSER_URL=http://localhost:2045
