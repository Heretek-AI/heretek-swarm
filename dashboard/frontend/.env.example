# Frontend API Configuration
# This file is for local development only. For Docker deployments, use docker-compose.yml environment variables.

# API Host - Set this to your server's IP/hostname for remote access
# Examples:
#   - Local development: http://localhost:8000
#   - Remote LAN: http://192.168.31.166:8000
#   - Production: https://api.yourdomain.com
# 
# When running in Docker with nginx proxy, leave empty or unset to use relative paths
# The nginx.conf proxies /api and /ws to the backend automatically
VITE_API_HOST=

# For development server (npm run dev) with remote backend:
# VITE_API_HOST=http://192.168.31.166:8000
