# Heretek Swarm - Autonomous Runtime Container
# 24/7 continuous operation entry point
#
# Usage:
#   docker build -f docker/Dockerfile.autonomous -t heretek-swarm:autonomous .
#   docker run -d --name heretek-swarm heretek-swarm:autonomous

FROM python:3.11-slim

LABEL maintainer="Heretek Swarm"
LABEL description="Autonomous AI Swarm - 24/7 Continuous Operation"
LABEL version="1.0.0"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY pyproject.toml README.md ./

# Copy source code
COPY src/ ./src/
COPY migrations/ ./migrations/

# Copy docker entrypoint
COPY docker/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Install the package
RUN pip install -e .[all]

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash heretek
RUN chown -R heretek:heretek /app
USER heretek

# Expose ports
# 8000 - API Gateway
# 18789 - A2A Protocol Server
# 18790 - MCP Server
EXPOSE 8000 18789 18790

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

# Run autonomous entry point
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["python", "-m", "heretek_swarm.runtime.main_loop"]
