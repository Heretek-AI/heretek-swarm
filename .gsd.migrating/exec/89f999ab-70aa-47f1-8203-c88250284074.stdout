71:
72:  test-python:
73:    name: Python Tests
74:    runs-on: ubuntu-latest
75:    services:
76:      postgres:
77:        image: postgres:16
78:        env:
79:          POSTGRES_USER: test
80:          POSTGRES_PASSWORD: test
81:          POSTGRES_DB: test_swarm
82:        ports:
83:          - 5432:5432
84:        options: >-
85:          --health-cmd pg_isready
86:          --health-interval 10s
87:          --health-timeout 5s
88:          --health-retries 5
89:
90:      redis:
91:        image: redis:7
92:        ports:
93:          - 6379:6379
94:        options: >-
95:          --health-cmd "redis-cli ping"
96:          --health-interval 10s
97:          --health-timeout 5s
98:          --health-retries 5
99:
100:      qdrant:
101:        image: qdrant/qdrant:latest
102:        ports:
103:          - 6333:6333
104:        options: >-
105:          --health-cmd "curl -f http://localhost:6333/health || exit 1"
106:          --health-interval 10s
107:          --health-timeout 5s
108:          --health-retries 5
109:
110:    steps:
111:      - uses: actions/checkout@v4
112:
113:      - name: Set up Python
114:        uses: actions/setup-python@v5
115:        with:
116:          python-version: ${{ env.PYTHON_VERSION }}
117:          cache: 'pip'
118:
119:      - name: Install dependencies
120:        run: |
121:          pip install -e ".[dev]"
122:
123:      - name: Run tests with coverage
124:        env:
125:          DATABASE_URL: postgresql://test:test@localhost:5432/test_swarm
126:          REDIS_URL: redis://localhost:6379
127:          QDRANT_URL: http://localhost:6333
128:        run: |
129:          pytest tests/ -v --cov=src --cov-report=xml --cov-report=html --cov-report=term || true
130:
131:      - name: Upload coverage to Codecov
132:        uses: codecov/codecov-action@v4
133:        if: always()
134:        with:
135:          file: ./coverage.xml
136:          flags: python
137:          name: codecov-umbrella
138:
