57:          cache: 'npm'
58:          cache-dependency-path: swarm-dashboard/package-lock.json
59:
60:      - name: Install dependencies
61:        working-directory: swarm-dashboard
62:        run: npm ci
63:
64:      - name: Run ESLint
65:        working-directory: swarm-dashboard
66:        run: npm run lint || true
67:
68:      - name: Run TypeScript check
