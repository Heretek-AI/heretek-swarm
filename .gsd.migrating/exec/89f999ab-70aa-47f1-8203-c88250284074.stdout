13:jobs:
14:  security-scan:
15:    name: Security Scan
16:    runs-on: ubuntu-latest
17:    steps:
18:      - uses: actions/checkout@v4
19:
20:      - name: Run Bandit Security Scan
21:        run: |
22:          pip install bandit[toml]
