24:
25:  lint-python:
26:    name: Python Linting
27:    runs-on: ubuntu-latest
28:    steps:
29:      - uses: actions/checkout@v4
30:
31:      - name: Set up Python
32:        uses: actions/setup-python@v5
33:        with:
34:          python-version: ${{ env.PYTHON_VERSION }}
35:          cache: 'pip'
36:
37:      - name: Install dependencies
38:        run: |
39:          pip install -e ".[dev]"
40:
41:      - name: Run Ruff
42:        run: ruff check src/ tests/
43:
44:      - name: Run MyPy
45:        run: mypy src/ --ignore-missing-imports || true
46:
47:  lint-frontend:
48:    name: Frontend Linting
49:    runs-on: ubuntu-latest
50:    steps:
