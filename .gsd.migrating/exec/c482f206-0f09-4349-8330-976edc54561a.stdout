"""
Heretek Swarm CLI

Command-line interface for Heretek Swarm deployment and management.
"""

from __future__ import annotations

import asyncio
import os
import signal
import shutil
import subprocess
import sys
import threading
import time
import webbrowser
from pathlib import Path
from typing import Any

import click
import difflib
import httpx
import structlog

from heretek_swarm.cli.config_loader import load_infrastructure_config
from heretek_swarm.cli.config_wizard import (
    AVAILABLE_PROVIDERS,
    list_configured_providers,
    add_provider,
    remove_provider,
    run_wizard,
    set_default_provider,
    validate_provider,
    prompt_for_provider,
)
from heretek_swarm.config.models import HealthStatus, InfrastructureService

logger = structlog.get_logger("cli")


