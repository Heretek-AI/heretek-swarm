--- docker-compose.yml (first 100 lines) ---
version: "3.8"

x-common-env: &common-env
  HERETEK_LOG_LEVEL: ${HERETEK_LOG_LEVEL:-INFO}
  HERETEK_HOME: /app/heretek_data
  ENVIRONMENT: ${ENVIRONMENT:-development}

x-healthcheck-defaults: &healthcheck-defaults
  interval: 30s
  timeout: 10s
  retries: 3
  start_period: 10s

services:
  # =============================================================================
  # Infrastructure Services
  # =============================================================================

  postgres:
    image: postgres:15
    environment:
      POSTGRES_USER: ${POSTGRES_USER:-postgres}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:-password}
      POSTGRES_DB: ${POSTGRES_DB:-heretek_swarm}
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
    healthcheck:
      <<: *healthcheck-defaults
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:-postgres} -d ${POSTGRES_DB:-heretek_swarm}"]
    restart: unless-stopped

  redis:
    image: redis:7-alpine
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      <<: *healthcheck-defaults
      test: ["CMD", "redis-cli", "ping"]
    restart: unless-stopped

  qdrant:
    image: qdrant/qdrant:latest
    ports:
      - "6333:6333"
      - "6334:6334"
    volumes:
      - qdrant_data:/qdrant/storage
    healthcheck:
      <<: *healthcheck-defaults
      test: ["CMD-SHELL", "curl -sf http://localhost:6333/healthz || exit 1"]
    restart: unless-stopped

  nats:
    image: nats:latest
    ports:
      - "4222:4222"
      - "8222:8222"
    command: ["-js"]
    volumes:
      - nats_data:/data
    healthcheck:
      <<: *healthcheck-defaults
      test: ["CMD-SHELL", "wget --spider -q http://localhost:8222/ || nc -z localhost 4222 || exit 1"]
    restart: unless-stopped

  # =============================================================================
  # API Service — 23 spawned agents
  # =============================================================================

  api:
    build:
      context: .
      dockerfile: backend/Dockerfile
    ports:
      - "8000:8000"
    environment:
      <<: *common-env
      HERETEK_API_KEY: ${HERETEK_API_KEY:-htsk_your_api_key_here}
      DATABASE_URL: ${DATABASE_URL:-postgresql+asyncpg://postgres:password@postgres:5432/heretek_swarm}
      REDIS_URL: ${REDIS_URL:-redis://redis:6379}
      QDRANT_HOST: ${QDRANT_HOST:-qdrant}
      QDRANT_PORT: ${QDRANT_PORT:-6333}
      QDRANT_URL: ${QDRANT_URL:-http://qdrant:6333}
      QDRANT_API_KEY: ${QDRANT_API_KEY:-}
      HERETEK_NATS_URL: ${HERETEK_NATS_URL:-nats://nats:4222}
      OPENAI_API_KEY: ${OPENAI_API_KEY:-}
      OPENAI_BASE_URL: ${OPENAI_BASE_URL:-https://api.minimax.io/v1}
      LLM_MODEL: ${LLM_MODEL:-MiniMax-M2.7}
      CORS_ORIGINS: ${CORS_ORIGINS:-*}
      RATE_LIMIT_ENABLED: ${RATE_LIMIT_ENABLED:-true}
      EMBEDDING_PROVIDER: ${EMBEDDING_PROVIDER:-openai_compatible}
      EMBEDDING_BASE_URL: ${EMBEDDING_BASE_URL:-http://127.0.0.1:13305/api/v1}
      EMBEDDING_API_KEY: ${EMBEDDING_API_KEY:-lemonade}
      EMBEDDER_MODEL: ${EMBEDDER_MODEL:-nomic-embed-text-v2-moe-GGUF}
      EMBEDDING_DIMENSIONS: ${EMBEDDING_DIMENSIONS:-768}
    depends_on:

--- .env.example (first 80 lines) ---
# Heretek Swarm Environment Configuration Example
# Copy this file to .env and fill in your actual values
#
# Docker Compose: `docker compose up` starts ALL 6 services:
#   postgres, redis, qdrant, nats, api, dashboard
#
# No --profile flags needed — all services start by default.

# =============================================================================
# API Configuration
# =============================================================================
HERETEK_API_KEY=htsk_your_api_key_here

# =============================================================================
# Environment
# =============================================================================
ENVIRONMENT=development

# =============================================================================
# CORS Configuration (Production)
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true

# =============================================================================
# Database Configuration
# =============================================================================
# Local dev:
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/heretek_swarm
# Docker Compose (use service name):
# DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/heretek_swarm
POSTGRES_PASSWORD=password

# =============================================================================
# Redis Configuration
# =============================================================================
# Local dev:
REDIS_URL=redis://localhost:6379
# Docker Compose: REDIS_URL=redis://redis:6379

# =============================================================================
# Qdrant Configuration (Vector Database)
# =============================================================================
# Local dev:
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=http://localhost:6333
# Docker Compose: QDRANT_HOST=qdrant  QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key_here

# =============================================================================
# NATS Configuration
# =============================================================================
# Local dev:
HERETEK_NATS_URL=nats://localhost:4222
# Docker Compose: HERETEK_NATS_URL=nats://nats:4222

# =============================================================================
# OpenAI Compatible LLM Configuration
# =============================================================================
# Supports any OpenAI-compatible API (MiniMax, Together, Fireworks, etc.)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.minimax.io/v1
LLM_MODEL=MiniMax-M2.7

# =============================================================================
# Embedding Provider (Lemonade Server / OpenAI Compatible)
# =============================================================================
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=http://127.0.0.1:13305/api/v1
EMBEDDING_API_KEY=lemonade
EMBEDDER_MODEL=nomic-embed-text-v2-moe-GGUF
EMBEDDING_DIMENSIONS=768

# =============================================================================

