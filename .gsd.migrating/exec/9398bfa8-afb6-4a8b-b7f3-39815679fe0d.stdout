--- pyproject.toml ---
[build-system]
requires = ["setuptools>=68.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "heretek-swarm"
version = "0.2.0"
description = "Heretek Swarm v2.0 - Next-generation multi-agent system built on Swarms framework"
readme = "README.md"
license = {text = "MIT"}
requires-python = ">=3.11"
authors = [
    {name = "Heretek AI", email = "engineering@heretek.ai"}
]
classifiers = [
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "License :: OSI Approved :: MIT License",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3.11",
    "Programming Language :: Python :: 3.12",
    "Topic :: Scientific/Engineering :: Artificial Intelligence",
]
dependencies = [
    "swarms>=5.0.0",
    "pydantic>=2.0.0",
    "httpx>=0.25.0",
    "redis>=5.0.0",
    "qdrant-client>=1.7.0",
    "opentelemetry-api>=1.22.0",
    "opentelemetry-sdk>=1.22.0",
    "opentelemetry-exporter-otlp>=1.22.0",
    "structlog>=24.1.0",
    "tenacity>=8.2.0",
    "circuitbreaker>=2.0.0",
    "starlette>=0.27.0",
    "uvicorn>=0.25.0",
    "websockets>=12.0",
    # mem0 integration for long-term memory
    "mem0ai>=1.0.0",
    # FastAPI for backend API
    "fastapi>=0.109.0",
    # CLI framework
    "click>=8.1.0",
    # Prometheus metrics
    "prometheus-client>=0.19.0",
    # NATS messaging
    "nats-py>=2.0.0",
]

[project.optional-dependencies]
core = [
    # Core swarm framework only
    "swarms>=5.0.0",
    "pydantic>=2.0.0",
    "structlog>=24.1.0",
    "tenacity>=8.2.0",
    "circuitbreaker>=2.0.0",
]
agents = [
    "heretek-swarm[core]",
    # Agent framework
    "starlette>=0.27.0",
    "uvicorn>=0.25.0",
    "websockets>=12.0",
    "fastapi>=0.109.0",
    "click>=8.1.0",
    "httpx>=0.25.0",
    # Memory
    "mem0ai>=1.0.0",
    # Vector storage
    "redis>=5.0.0",
    "qdrant-client>=1.7.0",
    # Observability
    "opentelemetry-api>=1.22.0",
    "opentelemetry-sdk>=1.22.0",
    "opentelemetry-exporter-otlp>=1.22.0",
]
