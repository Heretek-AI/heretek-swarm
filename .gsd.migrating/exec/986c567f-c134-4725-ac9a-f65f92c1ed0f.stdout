=== pyproject.toml key entries ===
[tool.setuptools.packages.find]
where = ["backend"]
include = ["heretek_swarm*"]
--
[tool.pytest.ini_options]
minversion = "8.0"
testpaths = ["tests"]
--
[tool.coverage.run]
branch = true
source = ["backend"]
--
[tool.coverage.paths]
source = [
    "backend/",
--
[tool.coverage.report]
precision = 2
show_missing = true
--
[tool.coverage.html]
directory = "htmlcov"
title = "Heretek Swarm Coverage Report"
--
[tool.coverage.xml]
output = "coverage.xml"

[tool.coverage.json]
output = "coverage.json"
pretty_print = true
--
[tool.ruff]
target-version = "py311"
line-length = 100
--
[tool.ruff.lint]
select = [
    "E",      # pycodestyle errors
